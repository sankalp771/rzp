{
  "name": "the-negotiator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation of agent-to-agent commerce: negotiation protocol, compliance firewall, Razorpay settlement, hash-chained audit ledger.",
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "evals": "pnpm --filter @negotiator/evals run evals"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
