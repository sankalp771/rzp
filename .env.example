# Copy to .env and fill in. .env is gitignored; NEVER commit real values.
# Every variable the system reads is documented here (CLAUDE.md §7).

# --- LLM providers (D008, D015). Free-tier keys.
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
# Which adapter each side uses: stub | gemini | groq | mistral.
# "stub" = deterministic curve only, no network (CI, key-less quickstart).
# Naming a provider WITHOUT its key refuses to boot — there is no silent
# downgrade to the stub; /health shows the effective provider. The demo
# line is three providers, three roles: BUYER=gemini, SELLER=groq,
# FIREWALL=mistral (separate quotas — a rate-limited buyer never starves
# the verifier). For the FIREWALL, "stub"/unset means NO intent-verifier
# (layer 1 only, every allow is `layer: policy`) — loud in /health and the
# log; there is deliberately no fake auditor that allows everything.
BUYER_LLM_PROVIDER=stub
SELLER_LLM_PROVIDER=stub
FIREWALL_LLM_PROVIDER=stub
# Model ids (defaults verified live 2026-08-25; override if a provider retires one)
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# MISTRAL_MODEL=mistral-small-latest
# Latency budget (FEATURE-006 #1, FEATURE-008 #4, FEATURE-009). Two
# invariants, because the seller's LLM call runs inside the merchant's HTTP
# reply and the firewall's intent-verifier + settlement dispatch + seller
# notification run inside its verdict reply:
#   BUYER_HTTP_TIMEOUT_MS > LLM_TOTAL_BUDGET_MS + merchant processing
#   BUYER_HTTP_TIMEOUT_MS > FIREWALL_LLM_BUDGET_MS + FIREWALL_DISPATCH_TIMEOUT_MS
#                           + FIREWALL_NOTIFY_TIMEOUT_MS + processing   (8+8+5 < 30)
# LLM_CALL_TIMEOUT_MS=8000     # per attempt (agents)
# LLM_TOTAL_BUDGET_MS=12000    # whole proposal incl. retries + backoff (agents)
# LLM_MAX_ATTEMPTS=3
# FIREWALL_LLM_BUDGET_MS=8000  # the verifier's whole call incl. retries
# BUYER_HTTP_TIMEOUT_MS=30000  # buyer's client timeout per exchange

# --- Compliance Firewall (FEATURE-008/009). Layer 1 is deterministic
# policy; layer 2 is the LLM intent-verifier (FIREWALL_LLM_PROVIDER above),
# which can only NARROW layer 1's allow: block, or escalate to a human.
# Human approval queue (PROTOCOL.md §7.9, D022): GET /review and
# POST /review/<hash> need this shared secret (header x-review-token);
# unset = the queue is disabled and a hold can only time out.
# scripts/review.mjs and the Day 10 dashboard use it.
FIREWALL_REVIEW_TOKEN=
# A hold nobody decides auto-blocks (ESCALATION_TIMEOUT, T10). Default
# 10 min; the demo uses a shorter window so the timeout path is showable.
# FIREWALL_ESCALATION_TIMEOUT_SEC=600
# FIREWALL_ESCALATION_SWEEP_MS=15000   # timer; reads also sweep lazily
# How long the BUYER waits on a hold before reporting `pending`
# (never `failed`): a human is at the other end, so minutes.
# VERDICT_POLL_TIMEOUT_MS=120000
# Seller agent ids a principal may buy from (comma-separated). Unset =
# merchant-demo only (safe direction: an unknown seller is blocked).
# FIREWALL_MERCHANT_ALLOWLIST=merchant-demo
# Velocity: allowed carts per PRINCIPAL per window (not per mandate — the
# demo signs a fresh mandate per run, so per-mandate would be dead code).
# Default 10/hour is the safe-direction default. Dev override for a demo
# afternoon or the Day 11 evals run (50 sessions):
# FIREWALL_VELOCITY_MAX=100
# FIREWALL_VELOCITY_WINDOW_SEC=3600
# Outbound waits the firewall bounds itself (see the inequality above).
# FIREWALL_DISPATCH_TIMEOUT_MS=8000   # settlement_request → settlement
# FIREWALL_NOTIFY_TIMEOUT_MS=5000     # verdict → seller
# Trusted principal public keys (comma-separated). Unset = PRINCIPAL_PUBLIC_KEY
# below — the demo's one-keypair convenience.
# FIREWALL_PRINCIPAL_KEYS=
# FIREWALL_DB_PATH=data/firewall.db
# FIREWALL_AGENT_ID=firewall-demo
# Receipt polling (buyer and merchant): GET /receipt on settlement until
# paid|failed or the window closes → outcome "pending" (never "paid").
# RECEIPT_POLL_INTERVAL_MS=500
# RECEIPT_POLL_TIMEOUT_MS=60000

# --- Razorpay — TEST MODE ONLY (CONSTRAINTS #2). Boot refuses non-test keys,
# the placeholder below, and an empty secret unless RAZORPAY_MODE=simulated.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Any secret string you choose; the self-signed simulated webhook uses it.
# If you ever register a real dashboard webhook, use the same value there
# with events order.paid, payment.captured, payment.failed.
# NOTE: Docker Compose interpolates `$` inside this file — write a literal
# dollar as `$$` or the container sees a different secret than you typed.
RAZORPAY_WEBHOOK_SECRET=
# live-test = real orders at api.razorpay.com with rzp_test_* keys (the
# demo); simulated = in-process fake with the same shapes (CI, key-less
# quickstart). Named explicitly; /health shows the effective mode.
RAZORPAY_MODE=simulated
# The buyer is an agent — no card tap, no checkout UI. With this ON,
# settlement self-posts a correctly HMAC-signed order.paid webhook after the
# (real) order exists. Real inbound webhooks need a public HTTPS endpoint,
# which v0.1 does not have (no tunnels) — see THREAT_MODEL non-goals.
# Code default OFF; loud at boot and in /health when on. Turning it on
# REQUIRES RAZORPAY_WEBHOOK_SECRET (boot refuses otherwise) — for the demo
# set both; CI copies this file verbatim, so it ships off.
PAYMENT_SIMULATION=off
# Second confirmation source: poll the Orders API on GET /receipt (optional).
# ORDER_STATUS_POLL=off
# Retry (F4): attempt ceiling and backoff base (baseMs × 2^(attempt-1)).
# SETTLEMENT_MAX_ATTEMPTS=5
# SETTLEMENT_BACKOFF_MS=500
# SETTLEMENT_DB_PATH=data/settlement.db
# SETTLEMENT_AGENT_ID=settlement-demo

# --- Long-lived keys (PROTOCOL.md §5). Raw 32-byte Ed25519, base64.
# Agents generate per-session keys at runtime; only these three are static.
# Generate all of them plus a CONTROL_TOKEN with:
#   pnpm build && node scripts/gen-keys.mjs >> .env
# The buyer refuses /control/run until FIREWALL_URL + FIREWALL_PUBLIC_KEY +
# SETTLEMENT_URL + SETTLEMENT_PUBLIC_KEY are all set (D010: it never
# negotiates without a firewall to register with). The merchant needs the
# same two public keys to accept verdicts and verify receipts.
FIREWALL_PRIVATE_KEY=
FIREWALL_PUBLIC_KEY=
SETTLEMENT_PRIVATE_KEY=
SETTLEMENT_PUBLIC_KEY=
# Principal (the human who signs Intent Mandates). DEMO CONVENIENCE ONLY:
# in the real design the principal key NEVER lives beside the agents — the
# human signs the mandate elsewhere and agents receive only the signed
# artifact (see THREAT_MODEL.md non-goals). Here the buyer's demo seed
# signs at boot with this key so one-command spinup works.
PRINCIPAL_PRIVATE_KEY=
PRINCIPAL_PUBLIC_KEY=
# Alternative to the demo seed: a complete principal-signed Intent Mandate
# as one JSON line — the shape the real design would use.
INTENT_MANDATE_JSON=

# --- Service addressing (defaults match docker-compose.yml)
MERCHANT_URL=http://merchant:4001
BUYER_URL=http://buyer:4002
FIREWALL_URL=http://firewall:4003
SETTLEMENT_URL=http://settlement:4004

# --- Control plane (FEATURE-005 amendment #1)
# Shared secret for the buyer's POST /control/run (header x-control-token).
# The endpoint triggers a spending workflow, so it refuses to serve until
# this is set. Demo-grade auth; production would sit behind operator auth.
CONTROL_TOKEN=
# Host-side addresses for the demo scripts (Compose publishes these ports).
# BUYER_URL_LOCAL=http://localhost:4002
# FIREWALL_URL_LOCAL=http://localhost:4003
# MERCHANT_URL_LOCAL=http://localhost:4001
# SETTLEMENT_URL_LOCAL=http://localhost:4004

# --- Audit ledgers + operator console (FEATURE-010, D023/D024)
# Every service keeps its own append-only hash-chained ledger. The read API
# (GET /ledger, /ledger/verify, /sessions, merchant GET/PUT /policy) on all
# four services needs this shared secret (header x-dashboard-token); unset =
# the operator API is disabled (503). scripts/verify-ledgers.mjs and the
# dashboard proxy use it. HONEST SCOPE: one token reads every party's chain
# (including the buyer's mandate budget) and, through the dashboard, acts
# as reviewer / policy owner / operator — a fully trusted console for a
# demo where you are every party. Real deployment: per-party read tokens
# and operator identity in front (THREAT_MODEL non-goals).
DASHBOARD_TOKEN=
# The dashboard (:4005, published on localhost only) proxies to the four
# services and injects the tokens server-side; the browser never holds one.
# DASHBOARD_PROXY_TIMEOUT_MS=600000   # a held run waits minutes
# EVALS_REPORT_PATH=evals/report.json # the Evals tab reads it when it exists (Day 11)

# --- Service knobs (defaults shown; all optional)
# CLOCK_SKEW_SEC=120          # boundary timestamp window, PROTOCOL.md §4
# MERCHANT_DB_PATH=data/merchant.db
# BUYER_DB_PATH=data/buyer.db
# MERCHANT_AGENT_ID=merchant-demo
# BUYER_AGENT_ID=buyer-demo

# --- Misc
LOG_LEVEL=info
