{
  "name": "@negotiator/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ACNP wire protocol: schemas, canonical serialization, Ed25519 signing, replay guard",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/index.d.ts",
      "import": "./dist/fixtures/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas": "tsx scripts/export-json-schemas.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
