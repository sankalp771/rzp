{
  "$id": "https://negotiator.dev/schemas/acnp/0.1/message/mandate_register.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocol": {
      "type": "string",
      "const": "ACNP"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "type": {
      "type": "string",
      "const": "mandate_register"
    },
    "message_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "session_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "seq": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "in_reply_to": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$"
    },
    "sender": {
      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "enum": ["buyer", "seller", "firewall", "settlement"]
        }
      },
      "required": ["agent_id", "role"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "body": {
      "type": "object",
      "properties": {
        "intent_mandate": {
          "type": "object",
          "properties": {
            "goal": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "budget_ceiling": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "constraints": {
              "type": "object",
              "properties": {
                "max_quantity": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "categories_allowed": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "deadline": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
                },
                "delivery_max_days": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["max_quantity", "categories_allowed", "deadline", "delivery_max_days"]
            },
            "preferences": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 4000
              }
            },
            "max_rounds": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 50
            },
            "valid_until": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            },
            "principal_id": {
              "type": "string",
              "minLength": 1
            },
            "principal_public_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9+/]{43}=$"
            },
            "issued_at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
            },
            "signature": {
              "type": "object",
              "properties": {
                "alg": {
                  "type": "string",
                  "const": "Ed25519"
                },
                "key_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "value": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9+/]{86}==$"
                }
              },
              "required": ["alg", "key_id", "value"]
            }
          },
          "required": [
            "goal",
            "budget_ceiling",
            "constraints",
            "max_rounds",
            "valid_until",
            "principal_id",
            "principal_public_key",
            "issued_at",
            "signature"
          ]
        },
        "buyer_public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        }
      },
      "required": ["intent_mandate", "buyer_public_key"]
    },
    "signature": {
      "type": "object",
      "properties": {
        "alg": {
          "type": "string",
          "const": "Ed25519"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{86}==$"
        }
      },
      "required": ["alg", "key_id", "value"]
    }
  },
  "required": [
    "protocol",
    "version",
    "type",
    "message_id",
    "session_id",
    "seq",
    "sender",
    "timestamp",
    "body",
    "signature"
  ],
  "additionalProperties": false
}
